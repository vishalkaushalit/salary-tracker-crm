{
  "version": 2,
  "buildCommand": "node bin/vite.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets|manifest\\.json|sw\\.js|icon-.*|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
